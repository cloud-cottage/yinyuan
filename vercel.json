{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/console", "destination": "/console.html" },
    { "source": "/console/:path*", "destination": "/console.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/docs/quickstart", "destination": "/index.html" },
    { "source": "/org", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
